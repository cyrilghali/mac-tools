#!/usr/bin/env bash
# veille — Fetch and optionally summarize tech news from Newsboat
# Usage:
#   veille                  # Summarize today's unread articles with AI
#   veille --raw            # Just dump articles, no AI
#   veille --tag elixir     # Filter by tag (elixir, ai, scaleup, etc.)
#   veille --days 3         # Look back 3 days (default: 1)
#   veille --limit 50       # Max articles (default: 30)
#   veille --reload         # Reload feeds before summarizing
#   veille --lang fr        # Summary language: fr or en (default: fr)

set -euo pipefail

DB="$HOME/.newsboat/cache.db"
URLS="$HOME/.newsboat/urls"
DAYS=1
LIMIT=30
TAG=""
RAW=false
RELOAD=false
LANG="fr"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --raw)     RAW=true; shift ;;
    --tag)     TAG="$2"; shift 2 ;;
    --days)    DAYS="$2"; shift 2 ;;
    --limit)   LIMIT="$2"; shift 2 ;;
    --reload)  RELOAD=true; shift ;;
    --lang)    LANG="$2"; shift 2 ;;
    -h|--help)
      sed -n '2,9p' "$0" | sed 's/^# //' | sed 's/^#//'
      exit 0 ;;
    *) echo "Unknown option: $1"; exit 1 ;;
  esac
done

if [[ ! -f "$DB" ]]; then
  echo "Error: Newsboat cache not found at $DB"
  echo "Run 'newsboat' at least once to initialize."
  exit 1
fi

# Reload feeds if requested
if $RELOAD; then
  echo "Reloading feeds..."
  newsboat -x reload 2>/dev/null
  echo "Done."
fi

# Build feed URL filter for tag if specified
TAG_FILTER=""
if [[ -n "$TAG" ]]; then
  # Extract feed URLs matching the tag from the urls file
  TAG_URLS=$(grep -E " ${TAG}( |$)" "$URLS" 2>/dev/null | awk '{print $1}' | sed "s/.*/'&'/" | paste -sd, -)
  if [[ -z "$TAG_URLS" ]]; then
    echo "No feeds found with tag: $TAG"
    echo "Available tags:"
    grep -o '"[a-z-]*"$' "$URLS" 2>/dev/null | tr -d '"' | sort -u
    exit 1
  fi
  TAG_FILTER="AND i.feedurl IN ($TAG_URLS)"
fi

# Query articles from the last N days
SINCE=$(( $(date +%s) - DAYS * 86400 ))

# Use a simple query (no JOIN) to avoid issues with corrupted rss_feed index
# Feed name is extracted from the feedurl via the urls file mapping
ARTICLES=$(sqlite3 -separator '  |  ' "$DB" "
  SELECT
    i.feedurl,
    i.title,
    i.url
  FROM rss_item i
  WHERE i.deleted = 0
    AND i.pubDate >= $SINCE
    $TAG_FILTER
  ORDER BY i.pubDate DESC
  LIMIT $LIMIT;
" 2>/dev/null)

# Replace feedurl with human-readable feed name from urls file
if [[ -n "$ARTICLES" ]]; then
  while IFS= read -r line; do
    feedurl=$(echo "$line" | cut -d'|' -f1 | xargs)
    rest=$(echo "$line" | cut -d'|' -f2-)
    # Look up display name from urls file
    feed_name=$(grep -F "$feedurl" "$URLS" 2>/dev/null | grep -o '"~[^"]*"' | tr -d '"~' | head -1)
    [[ -z "$feed_name" ]] && feed_name=$(echo "$feedurl" | sed 's|https\?://||;s|/.*||')
    echo "$feed_name  |$rest"
  done <<< "$ARTICLES" > /tmp/veille_articles.tmp
  ARTICLES=$(cat /tmp/veille_articles.tmp)
  rm -f /tmp/veille_articles.tmp
fi

if [[ -z "$ARTICLES" ]]; then
  echo "No articles found for the last $DAYS day(s)${TAG:+ with tag '$TAG'}."
  echo "Try: veille --days 3 or veille --reload"
  exit 0
fi

COUNT=$(echo "$ARTICLES" | wc -l | tr -d ' ')

if $RAW; then
  echo "── $COUNT articles (last $DAYS day(s))${TAG:+ [tag: $TAG]} ──"
  echo ""
  echo "$ARTICLES"
  exit 0
fi

# AI Summary via Claude CLI
if ! command -v claude &>/dev/null; then
  echo "Claude CLI not found. Install it or use --raw mode."
  exit 1
fi

echo "── Veille Tech · $COUNT articles (last $DAYS day(s))${TAG:+ [tag: $TAG]} ──"
echo ""

# Build the full prompt with articles included
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

if [[ "$LANG" == "fr" ]]; then
  cat > "$TMPFILE" <<PROMPT
Tu es un assistant de veille technologique pour un engineering manager dans une scaleup tech (stack: Elixir/Phoenix, NestJS/TypeScript, Terraform, AI/LLM).

Voici $COUNT articles tech récents. Fais-en une synthèse structurée et actionable en français :

1. **Top 3-5 articles à lire absolument** — avec une phrase expliquant pourquoi c'est pertinent pour un EM en scaleup
2. **Tendances clés** — résume les thèmes qui émergent (2-3 max)
3. **Quick wins** — articles courts ou outils à tester rapidement
4. **Signaux faibles** — trucs moins évidents mais potentiellement importants

Sois concis, pas de blabla. Inclus les URLs des articles recommandés.

Articles :
$ARTICLES
PROMPT
else
  cat > "$TMPFILE" <<PROMPT
You are a tech watch assistant for an engineering manager at a tech scaleup (stack: Elixir/Phoenix, NestJS/TypeScript, Terraform, AI/LLM).

Here are $COUNT recent tech articles. Create a structured, actionable summary:

1. **Top 3-5 must-reads** — with one sentence on why it's relevant for a scaleup EM
2. **Key trends** — summarize emerging themes (2-3 max)
3. **Quick wins** — short articles or tools to try right away
4. **Weak signals** — less obvious but potentially important items

Be concise, no fluff. Include URLs for recommended articles.

Articles:
$ARTICLES
PROMPT
fi

# Use haiku for fast, cheap summaries
CLAUDECODE="" claude -p "$(cat "$TMPFILE")" --model haiku 2>/dev/null
